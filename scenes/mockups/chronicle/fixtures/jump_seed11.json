    {
      "type": "chronicle_entry",
      "entry_id": "ce_0003",
      "category": "regional_faction_shift",
      "region": "r_moorwick",
      "score": 8.0,
      "tick_range_start": 380,
      "tick_range_end": 900,
      "base_form": "Moorwick changed hands twice before midsummer. The Kaine Dominion garrison withdrew without a formal surrender, and the Ostrel Concord banner went up over a town hall still full of Kaine paperwork nobody had time to burn.",
      "expanded_form": "Moorwick changed hands twice before midsummer. The Kaine Dominion garrison withdrew without a formal surrender, and the Ostrel Concord banner went up over a town hall still full of Kaine paperwork nobody had time to burn. The new administrator, Warden Coel Ashby, kept the old ledgers open rather than rewrite the town's debts in Ostrel ink.",
      "mentions": [
