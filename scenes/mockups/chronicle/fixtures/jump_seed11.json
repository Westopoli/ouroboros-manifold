    {
      "type": "chronicle_entry",
      "entry_id": "ce_0005",
      "category": "chain_crisis_resolved_well",
      "region": "r_dray",
      "score": 6.0,
      "tick_range_start": 1350,
      "tick_range_end": 1750,
      "base_form": "Dray's Hollow starved for a season before the grain barges came. The shortage bred a small revolt that the local garrison put down without much bloodshed, and by autumn the granaries were fuller than before the failure that started it.",
      "expanded_form": "Dray's Hollow starved for a season before the grain barges came. The shortage bred a small revolt that the local garrison put down without much bloodshed, and by autumn the granaries were fuller than before the failure that started it. The barges came from Moorwick, which had grain to spare and, for once, a garrison willing to share it.",
      "mentions": [
