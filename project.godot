; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ouroboros"
run/main_scene="res://scenes/privacy_modal/privacy_modal.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="data"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EraConfig="*res://autoload/era_config.gd"
EraThemeResolver="*res://autoload/era_theme_resolver.gd"
ThemeConstants="*res://autoload/theme_constants.gd"
SceneRouter="*res://autoload/scene_router.gd"
UIDataBus="*res://autoload/ui_data_bus.gd"
ScanlineOverlay="*res://autoload/scanline_overlay.gd"
InputSanitizer="*res://autoload/input_sanitizer.gd"
TacticalBridge="*res://autoload/tactical_bridge.gd"
WsInputSanitizer="*res://autoload/ws_input_sanitizer.gd"
SimBridge="*res://autoload/sim_bridge.gd"
MissionMetricsRecorder="*res://autoload/mission_metrics_recorder.gd"
BugReportManager="*res://autoload/bug_report_manager.gd"
FactionPalette="*res://autoload/faction_palette.gd"
FeatureFlags="*res://autoload/feature_flags.gd"
InspectionState="*res://scenes/world/world_view_inspection_state.gd"
DebugOverlay="*res://autoload/debug_overlay.gd"
TutorialStateMachine="*res://autoload/tutorial_state_machine.gd"
QADaemon="*res://autoload/qa_daemon.gd"
SteamInit="*res://autoload/steam/steam_init.gd"
NetMatch="*res://autoload/net/net_match.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
