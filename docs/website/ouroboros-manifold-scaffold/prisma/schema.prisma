// =============================================================================
// Ouroboros Manifold — Database Schema
// Implements: webapp_architecture_1_00.md § Database Schema
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // Required for Neon serverless
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Auth — NextAuth.js standard tables (adapted for Auth.js v5 + Prisma adapter)
// =============================================================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String?   @unique // Nullable: Steam-only users may not have email
  emailVerified    DateTime? @map("email_verified")
  displayName      String?   @map("display_name")
  image            String?   // Provider avatar URL
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  purchases         Purchase[]
  keyRedemptions    AccessKey[]       @relation("RedeemedKeys")
  steamEntitlements SteamEntitlement[]
  eraProgress       EraProgress[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  // "oauth" | "email" | "credentials"
  provider          String  // "google" | "discord" | "steam" | "apple" | "email"
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// Commerce — Subscriptions and one-time purchases
// =============================================================================

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
  paused

  @@map("subscription_status")
}

model Purchase {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  eraId                String   @map("era_id") // e.g. "settled-reach", "roman"
  stripePaymentIntentId String  @unique @map("stripe_payment_intent_id")
  amountCents          Int      @map("amount_cents")
  currency             String   @default("usd")
  purchasedAt          DateTime @default(now()) @map("purchased_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("purchases")
}

// =============================================================================
// Access Keys — Promotional and distribution keys
// =============================================================================

model AccessKey {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  keyType       AccessKeyType @map("key_type")
  scope         Json         // { eras: ["1980s"] } or { eras: "all" }
  durationDays  Int?         @map("duration_days")   // For time_limited keys
  missionCount  Int?         @map("mission_count")   // For mission_limited keys
  createdAt     DateTime     @default(now()) @map("created_at")
  expiresAt     DateTime?    @map("expires_at")      // Key-level expiry (unredeemable after)

  // Redemption state
  redeemedBy    String?      @map("redeemed_by") @db.Uuid
  redeemedAt    DateTime?    @map("redeemed_at")

  redeemer User? @relation("RedeemedKeys", fields: [redeemedBy], references: [id])

  @@map("access_keys")
}

enum AccessKeyType {
  permanent
  time_limited
  mission_limited

  @@map("access_key_type")
}

// =============================================================================
// Steam — DLC ownership verification
// =============================================================================

model SteamEntitlement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  steamAppId  String   @map("steam_app_id")
  eraId       String   @map("era_id")
  verifiedAt  DateTime @map("verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, steamAppId])
  @@map("steam_entitlements")
}

// =============================================================================
// Progression — Per-era mastery tracking
// =============================================================================

model EraProgress {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  eraId             String   @map("era_id")
  missionsCompleted Int      @default(0) @map("missions_completed")
  masteryPoints     Int      @default(0) @map("mastery_points")
  tier              Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eraId])
  @@map("era_progress")
}
