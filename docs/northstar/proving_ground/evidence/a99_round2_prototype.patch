+/* Walks the kind-`kind` list of every cell a circle query at (x, y, r) covers (the cells
+ * om_grid_iter_begin_st would visit), calling nothing: callers inline the test through
+ * this macro-free pair of helpers below. Returns the first unit id after `cur` in the
+ * cell-major walk, 0 at the end; `cx`, `cy` carry the cell. */
+typedef struct { int32_t cx0, cx1, cy1, cx, cy; uint32_t cur; int kind; } om_kind_iter;
+
+static void om_kind_iter_begin(om_kind_iter *it, om_tac_state *st, int kind, double x, double y, double r) {
+    om_grid *g = &st->grid;
+    double reach = (r < 0.0 ? -r : r) + OM_GRID_PAD;
+    if (!g->built) om_grid_rebuild(st);
+    it->kind = kind; it->cur = 0; it->cy1 = -1; it->cx0 = it->cx1 = it->cx = 0; it->cy = 0;
+    if (!g->built) return;
+    it->cx0 = om_grid_coord(x - reach, g->ox, g->cell, g->cols);
+    it->cx1 = om_grid_coord(x + reach, g->ox, g->cell, g->cols);
+    it->cy1 = om_grid_coord(y + reach, g->oy, g->cell, g->rows);
+    it->cx = it->cx0;
+    it->cy = om_grid_coord(y - reach, g->oy, g->cell, g->rows);
+    it->cur = g->shead[((size_t)it->cy * (size_t)g->cols + (size_t)it->cx) * 2 + (uint32_t)kind];
+}
+
+static uint32_t om_kind_iter_next(om_kind_iter *it, const om_tac_state *st) {
+    const om_grid *g = &st->grid;
+    for (;;) {
+        if (it->cur) {
+            uint32_t id = it->cur;
+            it->cur = g->snext[(id - 1) * 2 + (uint32_t)it->kind];
+            return id;
+        }
+        if (it->cy > it->cy1) return 0;
+        if (++it->cx > it->cx1) {
+            it->cx = it->cx0;
+            if (++it->cy > it->cy1) return 0;
+        }
+        it->cur = g->shead[((size_t)it->cy * (size_t)g->cols + (size_t)it->cx) * 2 + (uint32_t)it->kind];
+    }
+}
