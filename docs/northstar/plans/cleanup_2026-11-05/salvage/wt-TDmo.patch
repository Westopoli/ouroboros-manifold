+def _run_light(cmds, timeout):
+    """Like _run but streams the output and keeps only each tactical frame's
+    (tick, mission_over, band) plus the last two frames: a deadline-length run
+    is tens of thousands of ~120 KB frames, too much to hold and parse whole."""
+    script = b"".join(_frame(c) for c in cmds + [QUIT])
+    proc = subprocess.Popen([str(PIPE)], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+    timer = threading.Timer(timeout, proc.kill)
+    timer.start()
+    try:
+        proc.stdin.write(script)
+        proc.stdin.close()
+        tacticals, tail = [], []
+        while True:
+            head = proc.stdout.read(4)
+            if len(head) < 4:
+                break
+            f = json.loads(proc.stdout.read(int.from_bytes(head, "big")))
+            if f["type"] == "tactical":
+                tacticals.append((f["tick"], f["mission_over"], f["band"]))
+            tail = (tail + [f["type"]])[-2:]
+        proc.wait()
+    finally:
+        timer.cancel()
+    return tacticals, tail
+
