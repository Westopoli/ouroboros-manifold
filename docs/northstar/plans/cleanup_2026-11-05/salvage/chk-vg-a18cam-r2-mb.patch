+		"A18 OWN UNITS ONLY G7: with a visible enemy unit and a sight field the framing is scale %s camera %s; the own units alone give scale %s camera %s" % [scale_busy, str(cam_busy), _scale(v), str(_cam(v))])
+	await _unmount(v)
