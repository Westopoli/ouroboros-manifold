index 561108dc..4adaf2d6 100644
--- a/scenes/ground3d/ground3d.gd
+++ b/scenes/ground3d/ground3d.gd
@@ -139,6 +139,8 @@ func set_frame(frame: Dictionary, mission: Dictionary) -> void:
 # While the camera keeps changing it runs at most once per OCCLUSION_RECOMPUTE_MS; the cached transform stays the old one
 # until a run, so the first run after the camera stops is the settle recompute.
 func _process(_delta: float) -> void:
+	if not _terrain.is_empty():
+		_recompute_occlusion()
 	if _terrain.is_empty() or _rig.get_camera().global_transform == _occlusion_xf:
 		return
 	if Time.get_ticks_msec() - _occlusion_ms >= OCCLUSION_RECOMPUTE_MS:
@@ -146,6 +148,25 @@ func _process(_delta: float) -> void:
 
 
 func _recompute_occlusion() -> void:
+	var t0 := Time.get_ticks_usec()
+	_recompute_occlusion_raw()
+	_stub_max = maxi(_stub_max, Time.get_ticks_usec() - t0)
+	_stub_last = (Time.get_ticks_usec() - t0) / 1000.0
+	_stub_passes += 1
+
+
+var _stub_max := 0
+var _stub_last := 0.0
+var _stub_passes := 0
+
+
+func occlusion_stats() -> Dictionary:
+	var d := {"max_slice_us": _stub_max, "last_pass_ms": _stub_last, "passes": _stub_passes, "pending": 0}
+	_stub_max = 0
+	return d
+
+
+func _recompute_occlusion_raw() -> void:
 	var cam: Camera3D = _rig.get_camera()
 	_occlusion_xf = cam.global_transform
 	_occlusion_ms = Time.get_ticks_msec()
