+/* VG E7 gap 9: the units of the composed roster the player starts with. Per type n_t = floor(count_t * start / F + 0.5); the remainder
+ * (positive or negative) lands on the type with the largest count_t, lowest type index on ties. Integer arithmetic only.
+ * DRAFT-cut-underflow: when that remainder would take the largest type below 0 (many types rounding up at once), the largest
+ * remaining n_t, lowest index on ties, gives one unit up at a time until the sum is start. The spec does not say; reported. */
+static void om_mission_cut_roster(const uint32_t *counts, uint32_t start, uint32_t *out) {
+    uint64_t f = 0;
+    int64_t sum = 0;
+    uint32_t big = 0;
+    for (uint32_t t = 0; t < OM_MISSION_N_UNIT_TYPES; t++) {
+        f += counts[t];
+        if (counts[t] > counts[big]) big = t;
+    }
+    for (uint32_t t = 0; t < OM_MISSION_N_UNIT_TYPES; t++) {
+        out[t] = f ? (uint32_t)((2ULL * counts[t] * start + f) / (2ULL * f)) : 0;
+        sum += out[t];
+    }
+    int64_t fixed = (int64_t)out[big] + ((int64_t)start - sum);
+    if (fixed >= 0) {
+        out[big] = (uint32_t)fixed;
+        return;
+    }
+    out[big] = 0;
+    sum = 0;
+    for (uint32_t t = 0; t < OM_MISSION_N_UNIT_TYPES; t++) sum += out[t];
+    while (sum > (int64_t)start) {
+        uint32_t hi = 0;
+        for (uint32_t t = 1; t < OM_MISSION_N_UNIT_TYPES; t++) if (out[t] > out[hi]) hi = t;
+        out[hi]--;
+        sum--;
+    }
+}
