@@ -154,6 +154,21 @@ def _in_block(b, layer, x, y):
     return b.layer_lo <= layer <= b.layer_hi and b.x0 <= x <= b.x1 and b.y0 <= y <= b.y1
 
 
+def skip_blocked(g, blocks):
+    """A blob group whose next cell is blocked on its layer takes the next free cell of its continued fill order."""
+    if g.formation != "blob" or g.count < 2:
+        return g
+    pts = []
+    for p in formations.blob_cells(g.count, g.x, g.y, g.params["radius"]):
+        if not any(_in_block(b, g.layer, p[0], p[1]) for b in blocks):
+            pts.append(p)
+            if len(pts) == g.count:
+                break
+    if pts == formations.place(g.formation, g.count, g.x, g.y, g.facing_deg, g.params):
+        return g
+    return dataclasses.replace(g, formation="points", params={"points": pts})
+
+
 def _placed(g):
     return formations.place(g.formation, g.count, g.x, g.y, g.facing_deg, g.params)
 
