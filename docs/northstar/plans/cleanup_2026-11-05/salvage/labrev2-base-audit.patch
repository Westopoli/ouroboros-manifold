+def blob_cells(n, x, y, radius):
+    """The fill order of a blob of n >= 2 units continued without end (reference for the audit)."""
+    pairs = n // 2
+    if n % 2:
+        yield (float(x), float(y))
+    i = 0
+    while True:
+        d = radius * math.sqrt((i + 0.5) / pairs)
+        a = i * _GOLDEN_ANGLE
+        dx, dy = round(d * math.cos(a), 6), round(d * math.sin(a), 6)
+        yield (float(x + dx), float(y + dy))
+        yield (float(x - dx), float(y - dy))
+        i += 1
+
+
 def place(kind, n, x, y, facing_deg, params):
     if kind not in _REQUIRED:
         raise ValueError("unknown formation %r" % (kind,))
