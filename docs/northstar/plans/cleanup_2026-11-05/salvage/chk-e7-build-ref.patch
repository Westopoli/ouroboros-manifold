+_CHILD = """
+import json, sys
+sys.path.insert(0, sys.argv[1])
+import conftest, test_VG_E_e7 as m
+lib = conftest.load_lib()
+make, _ = conftest._world_factory_for(lib, None)
+print(json.dumps(m.determinism_probe(lib, make, int(sys.argv[2]))))
+"""
