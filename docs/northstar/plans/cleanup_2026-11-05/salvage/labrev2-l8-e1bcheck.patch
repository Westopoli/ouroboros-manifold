+def _reengage(engine, w, setup, side_ids, side_of, hp, prev_hp, prev_pos, silent, armed, reengage, timeline, mut):
+    for s in (0, 1):
+        fired = any(hp[u] < prev_hp[u] for u in side_ids[1 - s])
+        moved = False
+        for u in side_ids[s]:
+            if hp[u] > 0:
+                p = engine.unit_pos(w, u)
+                if p != prev_pos[u]:
+                    moved = True
+                prev_pos[u] = p
+        if mut == "arm_on_move_only":
+            fired = False
+        if fired or moved:
+            silent[s], armed[s] = 0, True
+        else:
+            silent[s] += 1
+        if silent[s] < REENGAGE_SILENCE_TICKS or not armed[s]:
+            continue
+        enemy = [u for u in side_ids[1 - s] if hp[u] > 0]
+        mine = [u for u in side_ids[s] if hp[u] > 0]
+        vis = engine.visible_enemies(w, s, enemy) if enemy else set()
+        idle = [u for u in mine if timeline.role[u] and engine.unit_destination(w, u) is None]
+        if mut == "idle_consume" and vis and not idle:
+            armed[s] = False
+        if not vis or not idle:
+            continue
+        pts_set = enemy if mut == "all_living" else [u for u in enemy if u in vis]
+        if mut == "visible_centroid":
+            pts_set = enemy
+        pts = [engine.unit_pos(w, u) for u in pts_set]
+        engine.order_attack_move(w, idle, sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts))
+        reengage[s] += 1
+        armed[s] = False
