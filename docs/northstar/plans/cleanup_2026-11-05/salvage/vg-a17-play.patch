+# DRAFT-scroll-cap-ticks (ledger, Architect draft; Westley owns the threshold)
+SCROLL_STALL_TICKS = 60  # the camera did not move (more than 1.0 wu, TD-VG-A-9i) over this many game ticks: stall
+SCROLL_CAP_TICKS = 400  # a scroll that lasts this many game ticks without arriving: cap
+SCROLL_LOG: list = []  # one line per scroll (A17): wall s, game s, notches, scales, camera from/to, how it ended
+_TICK_CHECKED = False
+
+
+def _zoom_out_fully(client) -> int:
+    """Wheel notches the way a player does: input wheel -1 is ONE notch OUT (qa_driver.gd _do_wheel: n < 0 = WHEEL_DOWN;
+    +1 zooms in, TD-VG-C-1). One notch at a time while qa scale changes; returns the count of notches that changed it."""
+    notches, scale = 0, qa(client)["scale"]
+    while True:
+        client.call("input", "wheel", -1)
+        now = qa(client)["scale"]
+        if now == scale:
+            return notches
+        notches, scale = notches + 1, now
+
