+
+def _probe(g, s):
+    import subprocess as sp
+    out = sp.run("ss -tanp | grep ':%d' ; echo godot_alive=$(pgrep -fc godot.real)" % g.qa_port, shell=True, capture_output=True, text=True).stdout
+    with open(os.environ["PROBE_LOG"], "a") as f:
+        f.write("== %s port=%d elapsed_since_start=%.2f local=%s peer=%s\n%s\n" % (os.environ.get("PYTEST_CURRENT_TEST"), g.qa_port, time.monotonic()-getattr(g,"_t0",0), s.getsockname(), s.getpeername(), out))
