+	tw.tween_callback(func():
+		_transitioning = false
+		print("QADBG transition end (%s) f=%d ms=%d" % [scene_name, Engine.get_process_frames(), Time.get_ticks_msec()]))
 
 
 func go_back() -> void:
@@ -72,6 +75,7 @@ func _swap_scene(scene_name: String, params: Dictionary) -> void:
 	if old_scene:
 		old_scene.queue_free()
 
+	print("QADBG swap_scene(%s) f=%d ms=%d" % [scene_name, Engine.get_process_frames(), Time.get_ticks_msec()])
 	var new_scene_res = load(SCENES[scene_name])
 	var new_scene = new_scene_res.instantiate()
 	tree.root.add_child(new_scene)
