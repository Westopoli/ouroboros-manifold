diff --git a/autoload/scene_router.gd b/autoload/scene_router.gd
index c4afd831..725ead60 100644
--- a/autoload/scene_router.gd
+++ b/autoload/scene_router.gd
@@ -36,6 +36,7 @@ func _ready() -> void:
 
 func go_to(scene_name: String, params: Dictionary = {}) -> void:
 	if _transitioning:
+		print("QADBG go_to(%s) DROPPED: _transitioning f=%d ms=%d" % [scene_name, Engine.get_process_frames(), Time.get_ticks_msec()])
 		return
 	if not SCENES.has(scene_name):
 		if not ThemeConstants.IS_RELEASE_BUILD:
@@ -55,7 +56,9 @@ func go_to(scene_name: String, params: Dictionary = {}) -> void:
 	tw.tween_property(_overlay, "modulate:a", 1.0, ThemeConstants.FADE_DURATION)
 	tw.tween_callback(_swap_scene.bind(scene_name, params))
 	tw.tween_property(_overlay, "modulate:a", 0.0, ThemeConstants.FADE_DURATION)
