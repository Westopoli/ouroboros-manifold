{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "command.schema.json",
 "type": "object",
 "required": [
  "type",
  "name"
 ],
 "properties": {
  "type": {
   "const": "cmd"
  },
  "name": {
   "enum": [
    "step",
    "run_to",
    "snapshot",
    "set_seed",
    "set_feature",
    "inject",
    "save",
    "load",
    "net_reset",
    "net_submit",
    "net_step",
    "net_checksum",
    "net_log_dump",
    "net_log_load",
    "net_state_get",
    "net_state_put",
    "net_state_diff",
    "terrain_generate",
    "terrain_dump",
    "terrain_probe",
    "quit"
   ]
  },
  "n": {
   "type": "integer"
  },
  "tick": {
   "type": "integer"
  },
  "seed": {
   "type": "integer"
  },
  "n_regions": {
   "type": "integer"
  },
  "new_campaign": {
   "type": "boolean"
  },
  "features": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "feature": {
   "type": "integer"
  },
  "on": {
   "type": "boolean"
  },
  "bug": {
   "type": "integer"
  },
  "path": {
   "type": "string"
  },
  "peer": {
   "type": "integer"
  },
  "seq": {
   "type": "integer"
  },
  "arg": {
   "type": "integer"
  },
  "canvas": {
   "type": "number"
  },
  "layer": {
   "type": "integer"
  },
  "x": {
   "type": "number"
  },
  "y": {
   "type": "number"
  },
  "units": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "checksum": {
   "type": "boolean"
  },
  "hex": {
   "type": "string"
  },
  "state": {
   "type": "string"
  },
  "tactical_tick": {
   "type": "integer"
  },
  "steps": {
   "type": "integer"
  },
  "mission_archetype": {
   "type": "integer"
  },
  "placed_structures": {
   "type": "integer"
  }
 },
 "additionalProperties": true
}