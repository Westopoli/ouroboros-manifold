{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "snapshot.schema.json",
 "type": "object",
 "required": [
  "type",
  "tick",
  "checksum",
  "regions",
  "factions",
  "edges"
 ],
 "properties": {
  "type": {
   "const": "snapshot"
  },
  "tick": {
   "type": "integer"
  },
  "checksum": {
   "type": "integer"
  },
  "regions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "i",
     "owner",
     "military",
     "economy",
     "tension",
     "population",
     "stability",
     "capacity"
    ],
    "properties": {
     "i": {
      "type": "integer"
     },
     "owner": {
      "type": "integer"
     },
     "tier": {
      "type": "integer"
     },
     "military": {
      "type": "number"
     },
     "economy": {
      "type": "number"
     },
     "tension": {
      "type": "number"
     },
     "population": {
      "type": "number"
     },
     "stability": {
      "type": "number"
     },
     "capacity": {
      "type": "number"
     }
    },
    "additionalProperties": true
   }
  },
  "factions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id"
    ],
    "properties": {
     "id": {
      "type": "integer"
     },
     "archetype": {
      "type": "integer"
     },
     "budget": {
      "type": "number"
     },
     "tech": {
      "type": "number"
     },
     "stance": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     }
    },
    "additionalProperties": true
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "a",
     "b",
     "t"
    ],
    "properties": {
     "a": {
      "type": "integer"
     },
     "b": {
      "type": "integer"
     },
     "t": {
      "type": "integer"
     }
    },
    "additionalProperties": true
   }
  },
  "telegraphs": {
   "type": "array"
  }
 },
 "additionalProperties": true
}