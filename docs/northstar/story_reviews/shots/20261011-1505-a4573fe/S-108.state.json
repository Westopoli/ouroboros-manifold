      {
        "category": 3.0,
        "cluster_type": 1.0,
        "end_tick": 80.0,
        "expanded_mentions": [
          {
            "id": 76.0,
            "kind": "region",
            "len": 10.0,
            "start": 3.0
          },
          {
            "id": 76.0,
            "kind": "region",
            "len": 10.0,
            "start": 281.0
          }
        ],
        "expanded_text": "In the Barwyn, where Marrow had once walked with authority, a quieter era of diminishment began. Marrow name still appeared in the registries, but it carried a different weight now. Children of the household were raised on stories of what had been, and the silence of what was. In the Barwyn, the memory of Marrow decline served as cautionary scripture. Families who had once envied them now invoked their name as proof that nothing was guaranteed.",
        "fragment": 20.0,
        "fragment_ids": [
          20.0,
          32.0,
          35.0
        ],
        "id": 3.0,
        "mentions": [
          {
            "id": 76.0,
            "kind": "region",
            "len": 10.0,
            "start": 3.0
          }
        ],
        "refs": {
          "factions": [
            4.0
          ],
          "regions": [
