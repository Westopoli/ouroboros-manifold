            "len": 16.0,
            "start": 44.0
          },
          {
            "id": 3.0,
            "kind": "faction",
            "len": 16.0,
            "start": 70.0
          }
        ],
        "expanded_text": "Word of what was done at the Barwyn reached the Hollow Crown, held by the Iron Compact, where the echo of it was felt across the border.",
