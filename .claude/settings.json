{
  "autoCompactWindow": 400000,
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git checkout *--*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit *--amend*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(rm -rf .git*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh repo delete*)",
      "Read(./.env*)",
      "Read(./**/.env*)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python3:*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(~/.graphify-venv/bin/graphify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/kill-guard.sh"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mail-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/specfactory/method_check.py\" 2>/dev/null || echo \"METHOD error hook: method_check.py did not run from $CLAUDE_PROJECT_DIR (script missing or failed); run it by hand on this session and tell Westley\""
          }
        ]
      }
    ]
  }
}
